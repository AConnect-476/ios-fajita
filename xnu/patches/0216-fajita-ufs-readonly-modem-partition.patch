--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -445,6 +445,67 @@
 	return error;
 }
 
+/*
+ * The modem_a firmware partition is on UFS LUN 4 on this fajita unit.
+ * Read-only only: this never changes the root LUN or writes to any partition.
+ */
+int
+sweet_ufs_read_part(const char *name, uint64_t offset, void *dst, uint64_t len)
+{
+	static uint64_t first = 0, nblocks = 0;
+	static int cached = 0;
+	uint8_t saved_lun;
+	uint64_t bytes;
+	int error = 0;
+
+	if (!su.ready || name == NULL || (len != 0 && dst == NULL) ||
+	    strcmp(name, "modem_a") != 0) {
+		return EINVAL;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	saved_lun = su.lun;
+	su.lun = 4;
+	if (!cached) {
+		error = ufs_partition_extent("modem_a", &first, &nblocks);
+		if (error == 0) {
+			cached = 1;
+			printf("SWEET UFS: read-only modem_a LUN 4 blocks 0x%llx+0x%llx\n",
+			    first, nblocks);
+		}
+	}
+	if (error == 0) {
+		if (nblocks > UINT64_MAX / UFS_BLOCK) {
+			error = EOVERFLOW;
+		} else {
+			bytes = nblocks * UFS_BLOCK;
+			if (offset > bytes || len > bytes - offset) {
+				error = EINVAL;
+			}
+		}
+	}
+
+	for (uint64_t done = 0; error == 0 && done < len;) {
+		uint64_t pos = offset + done;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want_b = (uint32_t)MIN(len - done,
+		    (uint64_t)(BOUNCE_SIZE - skip));
+		uint32_t blocks = (skip + want_b + UFS_BLOCK - 1) / UFS_BLOCK;
+
+		su.lun = 4;
+		error = ufs_read_blocks(first + pos / UFS_BLOCK, blocks);
+		if (error == 0) {
+			memcpy((uint8_t *)dst + done,
+			    (const uint8_t *)(su.dma + DMA_BOUNCE) + skip, want_b);
+			done += want_b;
+		}
+	}
+
+	su.lun = saved_lun;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
 static int
 ufs_take_over_host(void)
 {
